Algoritmo "L01G"
// Disciplina   : [Lógica de Programação]
// Professor    : Jailson Costa dos Santos
// Descrição    : Calcula somas e produtos entre quatro números, dois a dois.
// Autor(a)     : Ana Luiza de Morais Bellini
// Data atual   : 18/09/2026
Var
   a, b, c, d: inteiro

Inicio
   Escreval("Digite A: ")
   Leia(a)
   Escreval("Digite B: ")
   Leia(b)
   Escreval("Digite C: ")
   Leia(c)
   Escreval("Digite D: ")
   Leia(d)

   Escreval("A + B = ", a + b, " | A * B = ", a * b)
   Escreval("A + C = ", a + c, " | A * C = ", a * c)
   Escreval("A + D = ", a + d, " | A * D = ", a * d)
   Escreval("B + C = ", b + c, " | B * C = ", b * c)
   Escreval("B + D = ", b + d, " | B * D = ", b * d)
   Escreval("C + D = ", c + d, " | C * D = ", c * d)

Fimalgoritmo
