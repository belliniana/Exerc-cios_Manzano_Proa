Algoritmo "L05G"
// Disciplina   : [Lógica de Programação]
// Professor    : Jailson Costa dos Santos
// Descrição    : Apresenta as potências de 3 do expoente 0 ao 15 sem operador de exponenciação.
// Autor(a)     : Ana Luiza de Morais Bellini
// Data atual   : 18/09/2026
Var
   expoente: inteiro
   potencia: real

Inicio
   potencia <- 1
   Para expoente de 0 ate 15 faca
      Escreval("3 elevado a ", expoente, " = ", potencia:0:0)
      potencia <- potencia * 3
   FimPara

Fimalgoritmo
