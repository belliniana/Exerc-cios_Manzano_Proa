Algoritmo "L04A"
// Disciplina   : [Lógica de Programação]
// Professor    : Jailson Costa dos Santos
// Descrição    : Apresenta os quadrados dos números de 15 a 200 usando REPITA.
// Autor(a)     : Ana Luiza de Morais Bellini
// Data atual   : 18/09/2026
Var
   numero: inteiro

Inicio
   numero <- 15
   Repita
      Escreval(numero, " ao quadrado = ", numero * numero)
      numero <- numero + 1
   Ate numero > 200

Fimalgoritmo
