Algoritmo "L01L"
// Disciplina   : [Lógica de Programação]
// Professor    : Jailson Costa dos Santos
// Descrição    : Calcula a soma dos quadrados de três valores.
// Autor(a)     : Ana Luiza de Morais Bellini
// Data atual   : 18/09/2026
Var
   a, b, c, resultado: real

Inicio
   Escreval("Digite A: ")
   Leia(a)
   Escreval("Digite B: ")
   Leia(b)
   Escreval("Digite C: ")
   Leia(c)
   resultado <- a*a + b*b + c*c
   Escreval("Soma dos quadrados: ", resultado:0:2)

Fimalgoritmo
