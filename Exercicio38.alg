Algoritmo "L05C"
// Disciplina   : [Lógica de Programação]
// Professor    : Jailson Costa dos Santos
// Descrição    : Soma os cem primeiros números inteiros usando PARA.
// Autor(a)     : Ana Luiza de Morais Bellini
// Data atual   : 18/09/2026
Var
   numero, soma: inteiro

Inicio
   soma <- 0
   Para numero de 1 ate 100 faca
      soma <- soma + numero
   FimPara
   Escreval("Soma de 1 até 100: ", soma)

Fimalgoritmo
